# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# --- GoPhish ---
# Se a plataforma e o GoPhish estiverem na mesma rede docker, use o nome do container:
GOPHISH_URL=https://gophish:3333
# Caso contrario, use o IP/host da VM: GOPHISH_URL=https://SEU_IP_DA_VM:3333
GOPHISH_API_KEY=coloque_sua_api_key_do_gophish_aqui
GOPHISH_VERIFY_SSL=false

# --- Seguranca da plataforma ---
# Gere algo aleatorio, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- Admin inicial (perfil SI), criado no primeiro start ---
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-forte

# --- Banco local da plataforma ---
DB_PATH=/data/app.db

# --- Identidade visual (marca) ---
# Opcional. Deixe em branco para a aparencia generica. Preencha para dar a
# cara da sua organizacao (nada disso fica no codigo; so aqui no .env).
BRAND_NAME=Security Awareness
BRAND_SHORT=Awareness
BRAND_TAGLINE=Conscientizacao em Seguranca da Informacao
# URL de um logo (png/svg). Vazio = usa um icone padrao + o nome.
# Com o logo preenchido, o texto do nome ao lado do logo some automaticamente.
BRAND_LOGO_URL=
# Favicon (opcional). Vazio = usa o logo, se houver, senao um escudo padrao.
BRAND_FAVICON_URL=
# Cores em hex. Padrao azul; troque pela paleta da sua marca.
BRAND_PRIMARY=#0a5bd3
BRAND_PRIMARY_DARK=#083f93
BRAND_ACCENT=#f39200
